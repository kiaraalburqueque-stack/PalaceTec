DB_NAME=palacetec
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password
DB_HOST=localhost
DB_PORT=5432

# Redis para Channels (WebSockets), la cache y el limitador de login. true por defecto.
# USE_REDIS=false usa memoria con cualquier base de datos (también PostgreSQL) y el /healthcheck
# muestra Redis como "disabled" sin marcarlo como error. En memoria, runserver y runroulette no
# comparten eventos: la ruleta se actualiza consultando cada 5 segundos.
# Con DB_ENGINE=sqlite y sin REDIS_URL también se usa memoria, aunque USE_REDIS sea true.
USE_REDIS=true
# REDIS_URL=redis://127.0.0.1:6379/0

# HU68: asistente virtual. faq (por defecto, sin servicios externos), gemini u openai.
# Sin ASSISTANT_API_KEY siempre se usan las preguntas frecuentes.
ASSISTANT_PROVIDER=faq
ASSISTANT_API_KEY=
# Opcional: modelo del proveedor (por defecto gemini-2.0-flash u gpt-4o-mini) y URL compatible con OpenAI.
ASSISTANT_MODEL=
ASSISTANT_BASE_URL=
ASSISTANT_TIMEOUT=10
